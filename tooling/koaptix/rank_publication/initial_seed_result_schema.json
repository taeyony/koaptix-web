  "title": "KOAPTIX exact V1/V2 compatibility bootstrap completion",
  "type": "object",
  "x-koaptix-semantic-validator": {
    "mode": "INITIAL_SEED_RESULT",
    "read_only_db_completion_evidence_required": true,
    "required_after_json_schema_validation": true,
    "schema_only_acceptance_prohibited": true,
    "tracked_file": "tooling/koaptix/rank_publication/validate_publication_result.py"
  },
  "x-koaptix-semantic-validator-rules": [
    "generation_id equals pointer_after.generation_id and publish_event.to_generation_id; publish_event.from_generation_id and pointer_after.previous_generation_id are null",
    "pointer_after.event_id equals publish_event.event_id, both publication versions equal 1, and pointer_after.published_at equals publish_event.recorded_at byte-for-value",
    "publish_event.plan_run_id equals plan_run_id and publish_event.execution_run_id equals seed_execution_run_id; expected_previous_version equals 0",
    "read-only database completion evidence contains exactly the named immutable generation, PUBLISH event and singleton pointer tuple and no unrelated event or generation is accepted",
    "source_authority_key selects one complete disjoint exact branch: V1 uses GLOBAL 2026-07-31/2026-07-30 with C560F4...92908, DED5CE...DB6C and combined F2C78A...1DE63; V2 uses GLOBAL 2026-08-26/2026-08-25 with E62394...B5FCB, B7B230...5FF82 and combined D59ED8...3C1BD",
    "both branches require the exact shared UNIVERSE_SERVICE null-date/225/40484/FB31BF...D8008/A1CCAC...07E2 component and vector 6E7BA4...82F7, but the shared SERVICE identity never authorizes a mixed GLOBAL or combined identity",
    "seed_packet_sha256 points one-way from the canonical packet into the completion; query, branch-selected control, vector file, logical vector and expected database result projection hashes are independently cross-bound by the runner without a completion-to-packet cyclic hash",
    "the selected database generation authority has affected_universe_codes=[], affected_rank_date=NULL and total_component_rows 53981; official history/snapshot write counts and all pre/post component mismatches are zero"
  ]
}
